<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for Android 11 and earlier (API 30 and below): nothing the app stores on the device is included
  in a cloud backup (see data_extraction_rules.xml for Android 12+).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
