# ---------------------------------------------------------------------------
# Narrow Gate Fitness — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.
# ---------------------------------------------------------------------------

# Public site URL (used for auth email redirects and Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). For local dev, `npx supabase start` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for Stripe webhooks, AI usage metering, account deletion and admin metrics.
SUPABASE_SERVICE_ROLE_KEY=

# AI coach (server-only). Leave blank to run with the AI coach disabled (graceful fallback).
ANTHROPIC_API_KEY=
# The AI coach is a Pro feature. Most requests run on the fast model; plan generation and complex coaching
# questions use the larger model, capped at PLAN_PRO_AI_SMART_MONTHLY_LIMIT requests a month (about 10%).
# Optional overrides. Defaults: fast claude-haiku-5-5, larger claude-sonnet-5-5.
COACH_MODEL_FAST=
COACH_MODEL_SMART=
# Per-user burst limit (requests per minute) for AI endpoints.
AI_RATE_LIMIT_PER_MINUTE=6

# Stripe (server-only). Leave blank to disable checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
# Yearly prices (optional; see BILLING_YEARLY_ENABLED below)
STRIPE_PRICE_PLUS_YEARLY=
STRIPE_PRICE_PRO_YEARLY=
# Earlier prices existing subscribers may still be on (comma-separated). When you create new prices, move the old
# IDs here so renewals keep mapping to the right plan. (Unknown prices on an existing subscription keep its stored plan.)
STRIPE_PRICE_PLUS_LEGACY=
STRIPE_PRICE_PRO_LEGACY=

# App Store / Google Play subscriptions through RevenueCat (see docs/MOBILE_BILLING.md). Leave blank to keep
# in-app purchases off. Use sandbox / Test Store until the owner approves real charges.
REVENUECAT_SECRET_API_KEY=
# The exact Authorization header value you set on the RevenueCat webhook (e.g. "Bearer <long random string>").
REVENUECAT_WEBHOOK_AUTH=
# Public SDK keys (appl_... / goog_...); safe to expose, they're sent to the app.
REVENUECAT_PUBLIC_KEY_IOS=
REVENUECAT_PUBLIC_KEY_ANDROID=
# RevenueCat entitlement identifiers for each plan (defaults: plus, pro).
REVENUECAT_ENTITLEMENT_PLUS=plus
REVENUECAT_ENTITLEMENT_PRO=pro
# Store product ids per plan/interval (comma-separated; Google Play ids may be "subscription" or "subscription:base-plan").
REVENUECAT_PRODUCTS_PLUS_MONTHLY=ngf_plus_monthly
REVENUECAT_PRODUCTS_PLUS_YEARLY=ngf_plus_yearly
REVENUECAT_PRODUCTS_PRO_MONTHLY=ngf_pro_monthly
REVENUECAT_PRODUCTS_PRO_YEARLY=ngf_pro_yearly
# Development only: count RevenueCat Test Store purchases. Never "true" in production.
REVENUECAT_ALLOW_TEST_STORE=false

# Final, legally reviewed documents (both required). Until set, the app links its in-app drafts, marked as drafts.
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=

# Plan configuration overrides (optional). Display prices in US cents; AI limits per calendar month.
PLAN_PLUS_PRICE_CENTS=1199
PLAN_PRO_PRICE_CENTS=2499
# Yearly plans stay hidden until this is "true". Approved prices: Plus $99.99, Pro $249.99 (override below).
# Web checkout for a yearly plan also needs that plan's STRIPE_PRICE_*_YEARLY.
BILLING_YEARLY_ENABLED=false
PLAN_PLUS_YEARLY_PRICE_CENTS=9999
PLAN_PRO_YEARLY_PRICE_CENTS=24999
PLAN_FREE_TEMPLATE_LIMIT=5
PLAN_PRO_AI_MONTHLY_LIMIT=150
PLAN_PRO_AI_PLAN_MONTHLY_LIMIT=15
PLAN_PRO_AI_SMART_MONTHLY_LIMIT=15

# Food search via USDA FoodData Central (free key: https://fdc.nal.usda.gov/api-key-signup.html).
# Optional: leave blank to search only the bundled USDA SR Legacy database (plus custom foods).
USDA_FDC_API_KEY=
# Optional: Open Food Facts mirror / local mock for tests (defaults to https://world.openfoodfacts.org)
OFF_API_BASE_URL=
