# ---------------------------------------------------------------------------
# Narrow Gate Fitness — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.
# ---------------------------------------------------------------------------

# Public site URL (used for auth email redirects and Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). For local dev, `npx supabase start` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for Stripe webhooks, AI usage metering, account deletion and admin metrics.
SUPABASE_SERVICE_ROLE_KEY=
# Longest a sign-in lasts before the member must sign in again, in days (1–365). Default 30 when unset or invalid.
# SESSION_MAX_AGE_DAYS=30
# Bot protection on sign-up, sign-in and password reset: the Cloudflare Turnstile *site* key (public). Its *secret* key
# goes in Supabase (Authentication → Attack Protection → CAPTCHA, provider Turnstile), never here. Leave blank to
# show no challenge (set it before inviting external testers).
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# AI coach (server-only). Leave blank to run with the AI coach disabled (graceful fallback).
ANTHROPIC_API_KEY=
# Seals coaching memories at rest (AES-256-GCM). 32 random bytes, base64: openssl rand -base64 32
# Required in production: without it the app refuses to store new memories. Keep it secret; rotating it needs
# scripts/encrypt-memories.ts --rekey.
MEMORY_ENCRYPTION_KEY=
# The AI coach is a Pro feature. Most requests run on the fast model; plan generation and complex coaching
# questions use the larger model, capped at PLAN_PRO_AI_SMART_MONTHLY_LIMIT requests a month (about 10%).
# Optional overrides. Defaults: fast claude-haiku-5-5, larger claude-sonnet-5-5.
COACH_MODEL_FAST=
COACH_MODEL_SMART=
# Per-user burst limit (requests per minute) for AI endpoints.
AI_RATE_LIMIT_PER_MINUTE=6
# AI spending limits in USD (src/server/services/ai-budget.ts). Blank or invalid means the default shown.
# Per Pro member per calendar month (default: the sustainable budget derived from the prices, about 1.40).
# AI_MEMBER_MONTHLY_BUDGET_USD=1.40
# For the whole app per calendar month. The default (100) suits testing only: it is used up by about 70 members
# spending their full allowance, after which the coach stops for everyone until the month ends. Before charging
# customers, set about (paying members x 1.40 x 1.2) and review it monthly. 0 turns every AI request away.
# AI_GLOBAL_MONTHLY_BUDGET_USD=100
# For the whole app per UTC day (default: twice the month's average day, e.g. 100 x 2 / 30 = 6.67).
# AI_GLOBAL_DAILY_BUDGET_USD=
# AI requests running at once across the app (default 20). Check the Anthropic organization's rate limits first.
# AI_MAX_CONCURRENT=20
# Optional: budget alerts (monthly at 50/75/90/100%, daily at 80/100%) are POSTed here as Slack-compatible {text}.
# AI_BUDGET_ALERT_WEBHOOK_URL=
# Model for the Bible study helper (Pro). Default claude-haiku-5-5.
# BIBLE_AI_MODEL=
# The weekly report's short written summary uses the AI whenever ANTHROPIC_API_KEY is set; "off" keeps the report
# without it (the numbers are always shown).
# WEEKLY_REPORT_AI=off
# How long AI conversations are kept, in days (30–3650). Unset keeps them until the member deletes them or their
# account (the current behaviour). When set, the daily job GET/POST /api/maintenance/ai-retention (same
# "Authorization: Bearer <CRON_SECRET>" as the billing job) deletes coach and Bible-helper messages older than this, and
# coach conversations with no activity since then. Coaching memories are not affected. State the same period in the
# Privacy Policy before setting it.
# AI_CHAT_RETENTION_DAYS=
# Tests and local evaluation only: send AI requests to a local mock (http://localhost or 127.0.0.1 only; anything
# else is ignored).
# ANTHROPIC_BASE_URL=

# Stripe (server-only). Leave blank to disable checkout. Use a test key (sk_test_...) until the owner approves real
# charges: a live key (sk_live_/rk_live_) is ignored unless STRIPE_LIVE_APPROVED=true.
STRIPE_SECRET_KEY=
STRIPE_LIVE_APPROVED=false
STRIPE_WEBHOOK_SECRET=
# Pro All Access, the only paid membership sold: a recurring USD price of $17.99/month and one of $119.99/year.
# Checkout refuses a configured price whose amount, currency or interval differs from the approved price.
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_YEARLY=
# Plus is no longer sold. Set these only if Plus subscriptions already exist, so their renewals keep mapping to Plus.
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PLUS_YEARLY=
# Earlier prices existing subscribers may still be on (comma-separated). When you create new prices, move the old
# IDs here so renewals keep mapping to the right plan. (Unknown prices on an existing subscription keep its stored plan.)
STRIPE_PRICE_PLUS_LEGACY=
STRIPE_PRICE_PRO_LEGACY=
# Promotion codes at web checkout. Off unless "true": when on, any active code in the Stripe account can be redeemed.
# STRIPE_ALLOW_PROMOTION_CODES=false
# Tests only: a local Stripe stand-in (http://localhost or 127.0.0.1 only; anything else is ignored).
# STRIPE_API_BASE_URL=

# Scheduled billing reconciliation (GET or POST /api/billing/reconcile with "Authorization: Bearer <CRON_SECRET>",
# e.g. every 30 minutes from the host's cron). It re-reads open subscriptions from Stripe/RevenueCat to repair missed
# webhooks and reports failed events. Use a long random value (at least 16 characters); blank refuses every call.
CRON_SECRET=
# Multiplies the app's sign-in / sign-up / email rate limits (never lowers them; capped at 100). Leave unset (1) in
# production; the automated browser tests raise it because they create many accounts from one machine. It is ignored
# on a production deployment (VERCEL_ENV=production or STRIPE_LIVE_APPROVED=true), see src/server/test-overrides.ts.
AUTH_RATE_LIMIT_SCALE=

# App Store / Google Play subscriptions through RevenueCat (see docs/MOBILE_BILLING.md). Leave blank to keep
# in-app purchases off. Use sandbox / Test Store until the owner approves real charges.
REVENUECAT_SECRET_API_KEY=
# The exact Authorization header value you set on the RevenueCat webhook (e.g. "Bearer <long random string>").
REVENUECAT_WEBHOOK_AUTH=
# Public SDK keys (appl_... / goog_...); safe to expose, they're sent to the app.
REVENUECAT_PUBLIC_KEY_IOS=
REVENUECAT_PUBLIC_KEY_ANDROID=
# RevenueCat entitlement identifiers for each plan (defaults: plus, pro).
REVENUECAT_ENTITLEMENT_PLUS=plus
REVENUECAT_ENTITLEMENT_PRO=pro
# Store product ids per plan/interval (comma-separated; Google Play ids may be "subscription" or "subscription:base-plan").
# Pro All Access store products ($17.99/month, $119.99/year). Plus ids only recognise existing Plus store subscriptions.
REVENUECAT_PRODUCTS_PRO_MONTHLY=ngf_pro_monthly,ngf_pro:monthly
REVENUECAT_PRODUCTS_PRO_YEARLY=ngf_pro_yearly,ngf_pro:yearly
REVENUECAT_PRODUCTS_PLUS_MONTHLY=ngf_plus_monthly
REVENUECAT_PRODUCTS_PLUS_YEARLY=ngf_plus_yearly
# Development only: count RevenueCat Test Store purchases. Never "true" in production.
REVENUECAT_ALLOW_TEST_STORE=false
# App Store / Play sandbox purchases (development builds, TestFlight, Apple's App Review) are free. With this false they
# count only for the accounts on the sandbox tester allow-list (admin -> Subscriptions -> Sandbox testers, by user id;
# migration 052): add App Review's demo account and your TestFlight testers there. "true" counts EVERY account's
# sandbox purchases (anyone with a TestFlight build gets Pro free): a separate test deployment only, never production.
# See docs/MOBILE_BILLING.md "Sandbox purchases".
REVENUECAT_ALLOW_SANDBOX=false
# Tests only: a local RevenueCat stand-in (http://localhost or 127.0.0.1 only; anything else is ignored).
# REVENUECAT_API_BASE_URL=

# Final, legally reviewed documents (both required). Until set, the app links its in-app drafts, marked as drafts.
LEGAL_TERMS_URL=
LEGAL_PRIVACY_URL=
# After a material change to final, counsel-reviewed Terms or Privacy Policy: members accept the new versions once.
LEGAL_REACCEPT_REQUIRED=false

# Plan configuration overrides (optional). Display prices in US cents; AI limits per calendar month.
# Displayed prices (US cents). Defaults are the approved prices; the store and Stripe prices must match them.
PLAN_PRO_PRICE_CENTS=1799
PLAN_PRO_YEARLY_PRICE_CENTS=11999
# What legacy Plus subscribers were charged (shown only to them).
PLAN_PLUS_PRICE_CENTS=1199
PLAN_FREE_TEMPLATE_LIMIT=5
PLAN_PRO_AI_MONTHLY_LIMIT=150
PLAN_PRO_AI_PLAN_MONTHLY_LIMIT=15
PLAN_PRO_AI_SMART_MONTHLY_LIMIT=15

# Food search via USDA FoodData Central (free key: https://fdc.nal.usda.gov/api-key-signup.html).
# Optional: leave blank to search only the bundled USDA SR Legacy database (plus custom foods).
USDA_FDC_API_KEY=
# Optional: Open Food Facts mirror / local mock for tests (defaults to https://world.openfoodfacts.org)
OFF_API_BASE_URL=

# Narrow Gate Food IQ: the experimental 0–100 nutritional-quality rating. Leave off in production until the method
# (docs/FOOD_IQ_METHOD.md) has been reviewed by a dietitian or nutrition scientist; "on" shows it, labelled experimental.
FOOD_IQ_SCORE=off

# --- Route map background (optional; OFF by default) ---
# Without these, run route maps draw a scale grid and nothing about a route leaves the app. Setting them makes every
# viewer's browser load map tiles from the provider for the area of the route, which tells that provider roughly where
# the member ran: update the Privacy Policy and accept the provider's terms (usage limits, attribution) first.
# Template must be https and contain {z}, {x} and {y}. Both URL and attribution are required, or tiles stay off.
# NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example.com/dark/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=© Example contributors
# NEXT_PUBLIC_MAP_TILE_MAX_ZOOM=19

# --- Error reports (optional; OFF by default) ---
# First-party reports of browser and server errors to /api/client-errors, written to the server log for the host's
# log drain or alerting (docs/ERROR_MONITORING.md). Both must be "on"; update the Privacy Policy before switching on.
# ERROR_REPORTING=on
# NEXT_PUBLIC_ERROR_REPORTING=on

# --- Build identity ---
# The commit /api/health reports (the iPhone build checks it). Vercel sets VERCEL_GIT_COMMIT_SHA itself; on other hosts
# set this to the deployed commit.
# NGF_BUILD_SHA=

# --- Demo mode (a separate, throwaway demo deployment only) ---
# "true" turns on the demo account, "Try onboarding" and simulated AI replies. Refused on a production or real-money
# deployment (VERCEL_ENV=production or STRIPE_LIVE_APPROVED=true) even when set (src/lib/demo/mode.ts).
# DEMO_MODE=false
# The seeded demo account's sign-in. `npm run demo` writes them to .demo-credentials.local (git-ignored); never commit them.
# DEMO_ACCOUNT_EMAIL=
# DEMO_ACCOUNT_PASSWORD=
