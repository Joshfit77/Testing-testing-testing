# ---------------------------------------------------------------------------
# Narrow Gate Fitness — environment variables
# Copy to .env.local for local development. Never commit real secrets.
# NEXT_PUBLIC_* values are exposed to the browser; everything else is server-only.
# ---------------------------------------------------------------------------

# Public site URL (used for auth email redirects and Stripe return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings → API). For local dev, `npx supabase start` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for Stripe webhooks, AI usage metering, account deletion and admin metrics.
SUPABASE_SERVICE_ROLE_KEY=

# AI coach (server-only). Leave blank to run with the AI coach disabled (graceful fallback).
ANTHROPIC_API_KEY=
# Optional model override.
AI_MODEL=claude-opus-5-5
# Per-user burst limit (requests per minute) for AI endpoints.
AI_RATE_LIMIT_PER_MINUTE=6

# Stripe (server-only). Leave blank to disable checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pro monthly price ID (recurring, USD, monthly). Required for checkout.
STRIPE_PRICE_PRO=
# Pro yearly price ID (recurring, USD, yearly). Optional; the yearly option is hidden without it.
STRIPE_PRICE_PRO_YEARLY=
# Legacy Plus price ID. Not sold to new members; set it only if Plus subscriptions already exist,
# so their webhooks still map to the Plus plan.
STRIPE_PRICE_PLUS=

# Plan configuration overrides (optional). Display prices in US cents; AI limits per calendar month.
# Checkout refuses to start if the Stripe price's amount differs from these, so keep them in sync.
PLAN_PLUS_PRICE_CENTS=999
PLAN_PRO_PRICE_CENTS=1999
PLAN_PRO_YEARLY_PRICE_CENTS=14999
PLAN_FREE_AI_MONTHLY_LIMIT=0
PLAN_PLUS_AI_MONTHLY_LIMIT=60
PLAN_PRO_AI_MONTHLY_LIMIT=400
PLAN_PRO_AI_PLAN_MONTHLY_LIMIT=20

# Food search via USDA FoodData Central (free key: https://fdc.nal.usda.gov/api-key-signup.html).
# Leave blank to use manual/custom foods only.
USDA_FDC_API_KEY=
